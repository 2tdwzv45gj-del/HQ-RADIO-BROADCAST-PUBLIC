# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Local backups and pre-change snapshots (keep files on Mac, don't publish)
*.backup
*.backup-*
*.before-*
*.before_*
*.tsbuildinfo

# Local recovery backups
/backups/

# Local snapshots and temporary files
*.bak
*.pyc
__pycache__/
*.known-good-*
*.genres-backup
*.now-playing-backup

# Historical catalog backups and monitoring reports
/data/*backup*/

# Dated local catalog snapshots
/data/*-backup-*.json
/data/*backup*.json
/data/monitor/*.json
!/data/monitor/.gitkeep

/node_modules/
/.next/
